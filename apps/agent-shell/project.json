{
  "name": "agent-shell",
  "projectType": "application",
  "sourceRoot": "apps/agent-shell/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack --mode=production --config apps/agent-shell/webpack.config.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack serve --mode=development --config apps/agent-shell/webpack.config.js"
      }
    }
  }
}
