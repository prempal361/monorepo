{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": {
    "defaultBase": "main"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "test"]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{project.root}/build"]
    }
  },
  "projects": {
    "agent-shell": "apps/agent-shell",
    "customer-mfe": "apps/customer-mfe",
    "product-mfe": "apps/product-mfe",
    "payment-mfe": "apps/payment-mfe",
    "policy-mfe": "apps/policy-mfe",
    "api-client": "libs/api-client"
  }
}
