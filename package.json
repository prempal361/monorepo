{
  "name": "prudential-agent-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Prudential Agent Portal Monorepo with Webpack 5 Module Federation",
  "scripts": {
    "start": "nx run-many --target=serve --all --parallel=10",
    "start:shell": "nx serve agent-shell",
    "start:payment": "nx serve payment-mfe",
    "start:customer": "nx serve customer-mfe",
    "start:product": "nx serve product-mfe",
    "start:policy": "nx serve policy-mfe",
    "build": "nx run-many --target=build --all --parallel",
    "build:shell": "nx build agent-shell",
    "build:payment": "nx build payment-mfe",
    "build:customer": "nx build customer-mfe",
    "build:product": "nx build product-mfe",
    "build:policy": "nx build policy-mfe",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.6.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@babel/preset-env": "^7.24.3",
    "@babel/preset-react": "^7.24.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.5.2",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "^18.2.4",
    "style-loader": "^3.3.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
